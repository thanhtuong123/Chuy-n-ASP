@model CMS.Data.Entities.Post

@{
    Layout = "_LayoutAdmin";
}

<h2 class="text-warning">SỬA BÀI VIẾT</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Tiêu đề</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Nội dung</label>
        <textarea asp-for="Content" class="form-control" rows="5"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Danh mục</label>
        <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-control"></select>
    </div>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="mb-3">
            <label class="form-label">Ảnh hiện tại</label><br />
            <img src="@Model.ImageUrl" width="180" />
        </div>
    }

    <div class="mb-3">
        <label class="form-label">Đổi ảnh mới</label>
        <input type="file" name="uploadImage" class="form-control" />
    </div>

    <button type="submit" class="btn btn-warning">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>