@model IEnumerable<CMS.Data.Entities.User>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý thành viên";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="m-0">QUẢN LÝ THÀNH VIÊN</h2>
    <a asp-action="Create" class="btn btn-success btn-sm">+ Tạo tài khoản</a>
</div>
<table class="table table-bordered table-striped text-center shadow-sm bg-white">
    <thead class="table-dark"><tr><th>ID</th><th>Tên đăng nhập</th><th>Họ và tên</th><th>Quyền hạn</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td><td class="fw-bold">@item.Username</td><td>@item.FullName</td>
            <td><span class="badge @(item.Role=="Admin" ? "bg-danger" : item.Role=="Editor" ? "bg-info" : "bg-secondary") p-2">@item.Role</span></td>
            <td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa tài khoản này không?')">Xóa</a></td>
        </tr>
    }
    </tbody>
</table>
