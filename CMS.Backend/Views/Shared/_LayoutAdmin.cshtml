<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background:#f5f6fa; }
        .admin-wrapper { display:flex; min-height:100vh; }
        .sidebar { width:260px; background:#1f2937; color:#fff; padding:20px 16px; }
        .sidebar .brand { font-weight:700; font-size:20px; margin-bottom:25px; }
        .sidebar a { display:block; color:#d1d5db; text-decoration:none; padding:10px 12px; border-radius:8px; margin-bottom:6px; }
        .sidebar a:hover { background:#374151; color:#fff; }
        .content { flex:1; padding:24px; }
        .topbar { background:#fff; border-radius:12px; padding:14px 20px; margin-bottom:20px; box-shadow:0 2px 10px rgba(0,0,0,.04); }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <div class="sidebar">
            <div class="brand"><i class="bi bi-speedometer2"></i> CMS Admin</div>

            <a asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Bảng điều khiển</a>
            <a asp-controller="Category" asp-action="Index"><i class="bi bi-grid"></i> Quản lý Danh mục</a>
            <a asp-controller="Post" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Quản lý Bài viết</a>
            <a asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam"></i> Quản lý Sản phẩm</a>
            <a asp-controller="CategoryProduct" asp-action="Index">
                <i class="bi bi-tags"></i> Danh mục sản phẩm
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Customer" asp-action="Index">
                    <i class="bi bi-person-lines-fill"></i> Quản lý Khách hàng
                </a>

                <a asp-controller="Order" asp-action="Index">
                    <i class="bi bi-cart-check"></i> Quản lý Đơn hàng
                </a>

                <a asp-controller="User" asp-action="Index">
                    <i class="bi bi-people"></i> Quản lý Thành viên
                </a>
            }
            <a asp-controller="Account" asp-action="Logout" class="text-danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a>
        </div>

        <main class="content">
            <div class="topbar d-flex justify-content-between align-items-center">
                <div>Xin chào, <strong>@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)</strong></div>
                <div class="badge bg-dark">@User.Claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value</div>
            </div>
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
