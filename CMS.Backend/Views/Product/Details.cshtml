@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container my-4">
    <h2 class="mb-4">CHI TIẾT SẢN PHẨM</h2>

    <div class="card shadow-sm">
        <div class="card-body row">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded" />
                }
                else
                {
                    <div class="bg-light p-5 text-center text-muted">
                        Chưa có ảnh
                    </div>
                }
            </div>

            <div class="col-md-8">
                <h3>@Model.Name</h3>

                <p>
                    <strong>Danh mục:</strong>
                    @(Model.CategoryProduct != null ? Model.CategoryProduct.Name : "Chưa có")
                </p>

                <p>
                    <strong>Giá:</strong>
                    @Model.Price.ToString("N0") VNĐ
                </p>

                <p>
                    <strong>Tồn kho:</strong>
                    @Model.StockQuantity
                </p>

                <p>
                    <strong>Mô tả:</strong>
                    @Model.Description
                </p>

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    Sửa
                </a>

                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại
                </a>
            </div>
        </div>
    </div>
</div>