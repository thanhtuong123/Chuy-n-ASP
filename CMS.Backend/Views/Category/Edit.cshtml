@model CMS.Data.Entities.Category
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "SỬA DANH MỤC"; }
<h2 class="mb-4">SỬA DANH MỤC</h2>
<form asp-action="Edit" method="post" class="card card-body shadow-sm border-0"><input type="hidden" asp-for="Id" /><div class="mb-3"><label class="form-label">Tên danh mục</label><input asp-for="Name" class="form-control" required /></div><div class="mb-3"><label class="form-label">Mô tả</label><textarea asp-for="Description" class="form-control"></textarea></div><button class="btn btn-success" type="submit">Cập nhật</button> <a asp-action="Index" class="btn btn-secondary">Quay lại</a></form>
