@model IEnumerable<CMS.Data.Entities.Category>
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Quản lý danh mục"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h2>QUẢN LÝ DANH MỤC</h2><a asp-action="Create" class="btn btn-success btn-sm">+ Thêm danh mục</a></div>
<table class="table table-bordered table-striped bg-white shadow-sm text-center"><thead class="table-dark"><tr><th>ID</th><th>Tên danh mục</th><th>Mô tả</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Id</td><td class="fw-bold">@item.Name</td><td>@item.Description</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a> @if(User.IsInRole("Admin")){<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Xóa danh mục này?')">Xóa</a>}</td></tr> }
</tbody></table>
