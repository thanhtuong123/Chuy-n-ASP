@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Bảng điều khiển";
}

<h2 class="mb-4">BẢNG ĐIỀU KHIỂN</h2>

<div class="row g-4">

    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5>Danh mục</h5>
                <h3>@ViewBag.CategoryCount</h3>
                <a asp-controller="Category"
                   asp-action="Index"
                   class="btn btn-dark btn-sm">
                    Xem
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5>Bài viết</h5>
                <h3>@ViewBag.PostCount</h3>
                <a asp-controller="Post"
                   asp-action="Index"
                   class="btn btn-dark btn-sm">
                    Xem
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5>Sản phẩm</h5>
                <h3>@ViewBag.ProductCount</h3>
                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-dark btn-sm">
                    Xem
                </a>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5>Thành viên</h5>
                    <h3>@ViewBag.UserCount</h3>
                    <a asp-controller="User"
                       asp-action="Index"
                       class="btn btn-dark btn-sm">
                        Xem
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Đơn hàng -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5>Đơn hàng</h5>
                <h3>@ViewBag.OrderCount</h3>

                <a asp-controller="Order"
                   asp-action="Index"
                   class="btn btn-dark btn-sm">
                    Xem
                </a>
            </div>
        </div>
    </div>

</div>