@model CMS.Data.Entities.Post
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Chi tiết bài viết"; }
<div class="card shadow-sm border-0"><div class="card-body"><h2>@Model.Title</h2><p class="text-muted">@Model.Category?.Name - @Model.CreatedDate.ToString("dd/MM/yyyy")</p>@if(!string.IsNullOrEmpty(Model.ImageUrl)){<img src="@Model.ImageUrl" class="img-fluid mb-3" style="max-height:300px" />}<p>@Model.Content</p><a asp-action="Index" class="btn btn-secondary">Quay lại</a></div></div>
