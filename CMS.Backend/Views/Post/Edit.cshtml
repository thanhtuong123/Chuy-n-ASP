@model CMS.Data.Entities.Post
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Sua bai viet"; }
<h2 class="mb-4">SUA BAI VIET</h2>
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="card card-body shadow-sm border-0">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label">Tieu de</label>
        <input asp-for="Title" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Noi dung</label>
        <textarea asp-for="Content" id="postContent" class="form-control" rows="6" required></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Danh muc</label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Anh bai viet</label>
        <input type="file" name="imageFile" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Cap nhat</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lai</a>
</form>
@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
    <script>
        ClassicEditor.create(document.querySelector('#postContent'));
    </script>
}
